<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ABC College Admission 2026</title>
</head>
<body>

    <!-- Header Banner -->
    <table bgcolor="#1a368d" width="100%" cellpadding="15" cellspacing="0" border="0">
        <tr>
            <td align="center">
                <font color="#ffffff" size="5"><b>ABC College Admission 2026</b></font>
            </td>
        </tr>
    </table>

    <!-- Main Content Layout Section -->
    <table width="600" align="center" cellpadding="20" cellspacing="0" border="0">
        <tr>
            <td>
                <h2>Courses and Fees</h2>
                
                <p align="center">Available Courses</p>
                
                <!-- Courses Grid Table Structure -->
                <table border="1" width="100%" cellpadding="8" cellspacing="0" bordercolor="#a0a0a0">
                    <thead>
                        <tr bgcolor="#e8ecf8">
                            <th align="left">Course</th>
                            <th align="left">Seats</th>
                            <th align="left">Fees</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>B.Tech CSE</td>
                            <td>120</td>
                            <td>&#8377;90,000</td>
                        </tr>
                        <tr>
                            <td>BCA</td>
                            <td>60</td>
                            <td>&#8377;45,000</td>
                        </tr>
                    </tbody>
                </table>
                <br>

                <!-- Application Container Form Setup -->
                <fieldset>
                    <legend>Application Form</legend>
                    <form action="#" method="POST">
                        <p>
                            <label for="name">Name:</label><br>
                            <input type="text" id="name" name="name" size="40">
                        </p>

                        <p>
                            <label for="email">Email:</label><br>
                            <input type="email" id="email" name="email" size="40">
                        </p>

                        <p>
                            <label for="course">Course:</label><br>
                            <select id="course" name="course">
                                <option value="btech">B.Tech CSE</option>
                                <option value="bca">BCA</option>
                            </select>
                        </p>

                        <p>
                            <label for="statement">Statement:</label><br>
                            <textarea id="statement" name="statement" rows="5" cols="60"></textarea>
                        </p>

                        <p>
                            <input type="submit" value="Apply">
                        </p>
                    </form>
                </fieldset>
            </td>
        </tr>
    </table>

    <!-- Footer Copyright Banner -->
    <table bgcolor="#1a368d" width="100%" cellpadding="10" cellspacing="0" border="0">
        <tr>
            <td align="center">
                <font color="#ffffff" size="2">&copy; 2026 ABC College</font>
            </td>
        </tr>
    </table>

</body>
</html>
