<!DOCTYPE html>
<html>
<head>
    <title>HTML Lists</title>
</head>
<body>
    <h2>Unordered List</h2>
    <ul>
        <li>HTML</li>
        <li>CSS</li>
        <li>JavaScript</li>
    </ul>

    <h2>Ordered List</h2>
    <ol type= "A">
        <li>Open VS Code</li>
        <li>Write code</li>
        <li>Open in browser</li>
    </ol>

    <h2>Description List</h2>
    <dl>
        <dt>HTML</dt>
        <dd>Used to make web pages.</dd>
        <dt>CSS</dt>
        <dd>Used to design web pages.</dd>
    </dl>
</body>
</html>
